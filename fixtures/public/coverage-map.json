[
  {
    "match": "(?!)",
    "product": "Example Product",
    "kinds": [
      "services",
      "listening"
    ],
    "routes": [
      {
        "type": "kev",
        "ref": "Microsoft Windows"
      },
      {
        "type": "manual",
        "ref": "Windows Update checklist"
      }
    ],
    "path_match": "^\"?C:\\\\Windows\\\\"
  },
